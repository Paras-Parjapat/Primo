# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate this with: npm run hash-password
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE

# Long random value used to sign session cookies
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: comma-separated allowed frontend origins when frontend is hosted separately
# Leave blank when this backend also serves the frontend from /public
FRONTEND_ORIGIN=

# Render sets PORT automatically. Local fallback is 3000.
PORT=3000
